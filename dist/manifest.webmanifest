{
  "name": "Emulsion: Grain Wallpapers",
  "short_name": "Emulsion",
  "description": "Create and save grainy abstract still wallpapers on your device, online or offline.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#090909",
  "theme_color": "#090909",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "id": "/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "categories": [
    "graphics",
    "personalization"
  ],
  "lang": "en",
  "shortcuts": [
    {
      "name": "Open studio",
      "url": "/app/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
